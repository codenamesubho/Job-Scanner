# Copy this file to .env and fill in your values
SEARCH_KEYWORDS=software engineer
SEARCH_LOCATION=Bengaluru, Karnataka, India
RESULTS_WANTED=25
HOURS_OLD=72

# Comma-separated jobspy sites for the "LinkedIn (jobspy)" scan button.
# Supported: linkedin, indeed, glassdoor, google, zip_recruiter, bayt, naukri
# (naukri via jobspy is blocked by a reCAPTCHA wall — use the "Naukri" login
# scan button instead, which uses Playwright with credentials).
JOBS_SOURCE=linkedin,indeed

# Optional: force the country jobspy's Indeed scraper searches in (must be one
# of jobspy's known country names/aliases, e.g. "india", "usa", "uk",
# "worldwide"). If unset, it's inferred from the Location field/text after the
# last comma, falling back to "worldwide".
INDEED_COUNTRY=

# RapidAPI key for JSearch (aggregates LinkedIn/Indeed/Glassdoor/ZipRecruiter).
# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# ── LLM provider split ────────────────────────────────────────────────────────
# JD extraction  → always Gemini (extract_job_requirements, cheap/fast)
# Resume extraction + scoring → LLM_PROVIDER below (Claude recommended)
# Both CLAUDE_API_KEY and GEMINI_API_KEY must be set.
LLM_PROVIDER=claude
CLAUDE_API_KEY=
GEMINI_API_KEY=

# Model for resume extraction, raw scoring, summaries, referral drafting (Claude)
CLAUDE_MODEL=claude-sonnet-4-20250514
# Model for JD extraction (Gemini) — falls back to GEMINI_MODEL if unset
GEMINI_MODEL=gemini-flash-latest
GEMINI_EXTRACT_MODEL=gemini-flash-latest

# ── Structured mode (SCORING_MODE=structured) ─────────────────────────────────
# JD extraction uses GEMINI_EXTRACT_MODEL above (already set).
# Resume extraction uses CLAUDE_STRUCTURED_SCORE_MODEL (Sonnet-class).
# Scoring uses CLAUDE_STRUCTURED_SCORE_MODEL.
# GEMINI_STRUCTURED_SCORE_MODEL is unused in this split but kept for flexibility.
CLAUDE_EXTRACT_MODEL=
CLAUDE_STRUCTURED_SCORE_MODEL=
GEMINI_STRUCTURED_SCORE_MODEL=

# LLM_MODEL is an optional blanket override for both providers — leave blank.
LLM_MODEL=

# raw (default) = free-text description scoring; structured =
# score structured JD/resume JSON (requires CLAUDE_EXTRACT_MODEL and
# CLAUDE_STRUCTURED_SCORE_MODEL above to be set). Structured scores are
# stored in separate structured_score* columns so they can be compared
# against the raw score.
SCORING_MODE=raw

# LinkedIn credentials for the Playwright-based scraper / referral finder
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Naukri credentials for the Playwright-based scraper
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Langfuse tracing (optional — leave blank to disable)
# Get your keys at https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
